DATABASE_URL=postgresql://...-pooler.neon.tech/moneyworks
DATABASE_URL_UNPOOLED=postgresql://...neon.tech/moneyworks

# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
# Any other length is rejected at runtime, so a truncated paste fails loudly rather than
# encrypting the SimpleFIN access URL under a key you cannot reproduce.
ENCRYPTION_KEY=

ALLOWED_EMAIL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Bearer token Vercel Cron sends to /api/sync, and the only thing authenticating that route.
# Generate with: openssl rand -hex 32
# Unset or blank rejects every sync request, including Vercel's own — the sync stops rather
# than the route opening up.
CRON_SECRET=

# One-time SimpleFIN setup token. Claimed on the first sync only; the access URL it returns
# is stored encrypted in the `secrets` table and used forever after, so this can be removed
# from the environment once a sync has succeeded.
SIMPLEFIN_SETUP_TOKEN=
